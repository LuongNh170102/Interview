# Local Environment
NODE_ENV=development
PORT=3000

# Database (Local Docker PostgreSQL)
DATABASE_URL="postgresql://admin:admin@localhost:5432/vhandelivery_db?schema=public"

# JWT / Auth
JWT_SECRET="local_secret_key_change_me"
JWT_EXPIRATION="1d"
JWT_REFRESH_SECRET="local_refresh_secret_key_change_me"
JWT_REFRESH_EXPIRATION="7d"
MAX_AGE_REFRESH_COOKIE=604800000  # 7 days in milliseconds

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Kakao OAuth
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Default Frontend URL (fallback if Host header is missing)
# Development:
FRONTEND_URL="http://localhost:4200"
B2B_FRONTEND_URL="http://localhost:4200"
MANAGEMENT_FRONTEND_URL="http://localhost:4300"
B2C_FRONTEND_URL="http://localhost:4400"

# Redis cache (optional — falls back to in-memory when unavailable)
REDIS_URL="redis://localhost:6379"
# Production:
# FRONTEND_URL="https://sharkbee.vn"

# Production domains (comma-separated, subdomains automatically matched)
PRODUCTION_DOMAINS=sharkbee.vn


# AWS S3 / MinIO (Local) — must match MINIO_ROOT_USER/PASSWORD in docker-compose
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_BUCKET_NAME=vhan-media
AWS_ENDPOINT=http://localhost:9000
AWS_FORCE_PATH_STYLE=true


# Other Local Configs
LOG_LEVEL=debug

